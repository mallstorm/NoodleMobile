                                        "text": "fun folderLabel(uri: String): String {\n    if (uri.isBlank()) return \"не выбрана\"\n    val id = runCatching { android.provider.DocumentsContract.getTreeDocumentId(Uri.parse(uri)) }.getOrDefault(uri)\n    return Uri.decode(id).substringAfter(':').ifBlank { \"Память устройства\" }.let { if (it == \"Память устройства\") it else \"/$it\" }\n}\n"
                                    }
                                }
                            }
                        }
