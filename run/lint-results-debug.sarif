                                    "endLine": 276,
                                    "snippet": {
                                        "text": "    private fun finalizeFile(destinationUri:String, partial:File, id:String, sourceUrl:String):String{\n        if(destinationUri.isBlank()) {\n            val ext=runCatching{Uri.parse(sourceUrl).lastPathSegment.orEmpty().substringAfterLast('.',\"\").take(8)}.getOrDefault(\"\").takeIf{it.matches(Regex(\"[A-Za-z0-9]{1,8}\"))}?.let{\".$it\"}.orEmpty()\n            val dir=File(applicationContext.filesDir,\"downloads/completed\").apply{mkdirs()}\n            val target=File(dir,\"$id$ext\"); if(target.exists())target.delete()\n"
                                    }
                                }
                            }
                        }
                    ],
