                                    "startLine": 50,
                                    "endLine": 55,
                                    "snippet": {
                                        "text": "    fun toJpeg(src: Bitmap, maxSide: Int = 1280, quality: Int = 88): ByteArray {\n        val scale = maxSide.toFloat() / maxOf(src.width, src.height)\n        val bmp = if (scale < 1f) Bitmap.createScaledBitmap(src, (src.width * scale).toInt().coerceAtLeast(1), (src.height * scale).toInt().coerceAtLeast(1), true) else src\n        val out = ByteArrayOutputStream()\n        bmp.compress(Bitmap.CompressFormat.JPEG, quality, out)\n"
                                    }
                                }
                            }
                        }
