{
  "version": 3,
  "id": "noodlemagazine.com",
  "name": "Noodlemagazine",
  "base_url": "https://noodlemagazine.com",
  "engine": "noodle_watch_playlist",
  "enabled": true,
  "capabilities": {
    "search": true,
    "pagination": true,
    "direct_url": true,
    "embedded_playback": true
  },
  "permissions": {
    "allowed_hosts": [
      "noodlemagazine.com",
      "*.noodlemagazine.com",
      "pvvstream.pro",
      "*.pvvstream.pro",
      "nmcorp.video",
      "*.nmcorp.video",
      "i.vimeocdn.com"
    ],
    "allow_javascript": true,
    "allow_cookies": true
  },
  "view": {
    "strategies": [
      "noodle_watch_playlist",
      "jwplayer_config",
      "videojs_config",
      "generic_html5",
      "oembed_provider",
      "iframe_chain",
      "hls_manifest",
      "dash_manifest",
      "playlist_json",
      "open_graph"
    ]
  },
  "adapter_version": "1.0.0",
  "publisher": "Noodle Desktop bundled",
  "homepage": "https://noodlemagazine.com",
  "health": {
    "query": "video",
    "min_results": 1,
    "require_playback": true,
    "auto_repair": false
  },
  "min_app_version": "1.9.0",
  "engine_dependencies": [
    "jwplayer_config",
    "videojs_config",
    "generic_html5",
    "oembed_provider",
    "iframe_chain",
    "hls_manifest",
    "dash_manifest"
  ],
  "repair": {
    "enabled": false,
    "mode": "conservative",
    "failure_threshold": 3,
    "cooldown_minutes": 60,
    "auto_quarantine": false,
    "strategies": [
      "resolver_refresh"
    ]
  }
}
