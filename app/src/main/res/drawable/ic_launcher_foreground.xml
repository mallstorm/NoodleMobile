<?xml version="1.0" encoding="utf-8"?>
<!-- Noodle: a play button inside a search lens — find video on any site, then watch it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- lens handle -->
    <path
        android:pathData="M63.5,63.5 L73,73"
        android:strokeColor="#FF4FE3C1"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
    <!-- lens ring -->
    <path
        android:pathData="M50,50m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0"
        android:fillColor="#00000000"
        android:strokeWidth="6.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="32" android:startY="32"
                android:endX="68" android:endY="68">
                <item android:offset="0" android:color="#FFD9C2FF" />
                <item android:offset="1" android:color="#FF9C6BFF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- play -->
    <path
        android:pathData="M45.5,41.5 Q45.5,39.6 47.2,40.5 L58.6,48.3 Q60.1,49.4 58.6,50.6 L47.2,58.5 Q45.5,59.4 45.5,57.5 Z"
        android:fillColor="#FF4FE3C1" />
    <!-- discovery spark -->
    <path
        android:pathData="M72,30 L73.6,34.4 L78,36 L73.6,37.6 L72,42 L70.4,37.6 L66,36 L70.4,34.4 Z"
        android:fillColor="#FFFFC857" />
</vector>
