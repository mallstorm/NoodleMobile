{
  "version": 3,
  "id": "video-laba.click",
  "name": "Video-labaClick",
  "base_url": "https://video-laba.click",
  "engine": "novideo_embed",
  "enabled": true,
  "capabilities": {
    "search": true,
    "pagination": true,
    "direct_url": true,
    "embedded_playback": true
  },
  "permissions": {
    "allowed_hosts": [
      "video-laba.click",
      "*.video-laba.click",
      "vwfastdelivery.com",
      "*.vwfastdelivery.com",
      "players-services.win",
      "*.players-services.win",
      "video-laba.link",
      "*.video-laba.link",
      "24fastload.net",
      "*.24fastload.net"
    ],
    "allow_javascript": true,
    "allow_cookies": true
  },
  "view": {
    "strategies": [
      "novideo_embed",
      "jwplayer_config",
      "videojs_config",
      "generic_html5",
      "oembed_provider",
      "iframe_chain",
      "hls_manifest",
      "dash_manifest",
      "iframe",
      "kvs_flashvars",
      "open_graph"
    ]
  },
  "adapter_version": "1.0.1",
  "publisher": "Noodle Desktop bundled",
  "homepage": "https://video-laba.click",
  "health": {
    "query": "mamki",
    "min_results": 1,
    "require_playback": true,
    "auto_repair": false
  },
  "min_app_version": "1.9.0",
  "engine_dependencies": [
    "jwplayer_config",
    "videojs_config",
    "generic_html5",
    "oembed_provider",
    "iframe_chain",
    "hls_manifest",
    "dash_manifest"
  ],
  "repair": {
    "enabled": false,
    "mode": "conservative",
    "failure_threshold": 3,
    "cooldown_minutes": 60,
    "auto_quarantine": false,
    "strategies": [
      "resolver_refresh"
    ]
  },
  "search": {
    "url_template": "/{query}/",
    "page_template": "/{query}/{page}/"
  }
}
